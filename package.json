{
  "name": "axioms-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "tsc -p tsconfig.json",
    "format": "prettier --write scripts tests browser playwright.config.ts src public package.json tsconfig.json vercel.json",
    "format:check": "prettier --check scripts tests browser playwright.config.ts src public package.json tsconfig.json vercel.json",
    "serve": "node scripts/serve.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "validate": "node scripts/validate.ts",
    "verify": "pnpm check && pnpm format:check && pnpm test && pnpm build && pnpm validate",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@design-axioms/color": "file:vendor/design-axioms-color/design-axioms-color-0.1.0.tgz",
    "@design-axioms/layout": "file:vendor/axiomatic-layout/design-axioms-layout-0.0.0-local.0.tgz",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@vercel/routing-utils": "6.6.1",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
