    },
    {
      "source": "/alpha-limitations/",
      "destination": "https://www.axioms.design/alpha-limitations/",
      "permanent": false
    },
    {
      "source": "/llms.txt",
      "destination": "https://www.axioms.design/llms.txt",
      "permanent": false
    },
    {
      "source": "/llms-full.txt",
